# google-services.json / GoogleService-Info.plist are ignored since 2026-09-12.
# Their API key values also ship inside every binary, so this does not make them
# secret; it keeps them out of a public repo that is scanned automatically. The
# build needs them, so after a fresh clone download both from the Firebase console
# (Project settings > Your apps). `git rm --cached` leaves the working copy alone,
# so an existing checkout keeps building.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# firebase_options.dart is ignored since 2026-09-12. This does not make its API
# keys secret: the same values sit in google-services.json / GoogleService-Info.plist
# and inside every shipped binary. What it does is keep them out of the file that
# GitHub's scanner flags. Pushing this file on 2026-09-06 was detected, reported to
# Google through the secret scanning partner program, and the project was suspended
# two days later. Run `flutterfire configure` after a fresh clone to regenerate it.
lib/firebase_options.dart

# Anything regenerable stays out (2026-09-19). `flutterfire configure` and the
# Firebase console write these back, so tracking them only publishes the
# project identifiers into a repository that is scanned automatically.
firebase.json
firebase_app_id_file.json

# Environment files
.env
.env.local
.env.production
.env.staging

# Generated files
*.g.dart
*.freezed.dart

# Build output. ios/build/ in particular: the other six apps hide it and these
# two did not, which left 29 XCBuildData files untracked and un-ignored.
/build/
ios/build/

# Workspace tooling, not part of this app. Six of the other repos already
# hide it; keeping one set of rules means the same review applies everywhere.
.claude/
.cursorignore

# --- Signing assets (added 2026-09-06) ---
# None of these are in any repository today. The rules exist so that a
# certificate exported to the project directory for a one-off cannot be
# committed by a later `git add -A`. Distribution certificates and the App
# Store Connect key grant publishing rights, and a leak is not fixed by
# deleting the file: the history keeps it.
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
